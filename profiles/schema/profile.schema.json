{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vanepoint-hq/vanepoint/blob/main/profiles/schema/profile.schema.json",
  "title": "Vanepoint App Profile",
  "description": "Maps a desktop application to Vanepoint phone surfaces and safe input actions. Profiles are pure data: they can only emit keyboard, mouse, scroll and built-in Vanepoint actions.",
  "type": "object",
  "required": ["schema", "id", "name", "match", "actions", "surfaces"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": 1, "description": "Profile schema version." },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$",
      "description": "Stable, unique, lowercase identifier, e.g. 'microsoft.powerpoint'."
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "authors": { "type": "array", "items": { "type": "string", "maxLength": 80 } },
    "description": { "type": "string", "maxLength": 280 },
    "match": { "$ref": "#/$defs/match" },
    "actions": {
      "type": "object",
      "description": "Named actions referenced by controls.",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" },
      "additionalProperties": { "$ref": "#/$defs/action" },
      "minProperties": 1
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    }
  },
  "$defs": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "macos": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundleId"],
          "properties": { "bundleId": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" } }
        },
        "windows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exe"],
          "properties": { "exe": { "type": "string", "pattern": "^[^\\\\/:*?\"<>|]+\\.(exe|EXE)$" } }
        },
        "titlePattern": {
          "type": "string",
          "maxLength": 200,
          "description": "Optional regular expression matched against the focused window title."
        }
      }
    },
    "key": {
      "type": "string",
      "description": "A W3C KeyboardEvent.code value or a modifier.",
      "pattern": "^(Meta|Control|Alt|Shift|Key[A-Z]|Digit[0-9]|F([1-9]|1[0-9]|2[0-4])|Arrow(Up|Down|Left|Right)|Enter|Escape|Space|Tab|Backspace|Delete|Home|End|PageUp|PageDown|Equal|Minus|BracketLeft|BracketRight|Backslash|Semicolon|Quote|Comma|Period|Slash|Backquote)$"
    },
    "chord": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/key" }
    },
    "actionRef": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "action": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "key" },
            "chord": { "$ref": "#/$defs/chord" },
            "macos": { "$ref": "#/$defs/chord" },
            "windows": { "$ref": "#/$defs/chord" },
            "repeat": { "type": "boolean", "description": "Auto-repeat while held." },
            "confirm": { "type": "boolean", "description": "Ask before running (for destructive shortcuts)." }
          },
          "anyOf": [
            { "properties": { "chord": true }, "required": ["chord"] },
            { "properties": { "macos": true, "windows": true }, "required": ["macos", "windows"] }
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "scroll" },
            "dx": { "type": "number", "minimum": -100, "maximum": 100 },
            "dy": { "type": "number", "minimum": -100, "maximum": 100 }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "mouse" },
            "button": { "enum": ["left", "right", "middle"] },
            "clicks": { "type": "integer", "minimum": 1, "maximum": 3 }
          },
          "required": ["button"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "sequence" },
            "steps": { "type": "array", "minItems": 2, "maxItems": 10, "items": { "$ref": "#/$defs/actionRef" } },
            "delayMs": { "type": "integer", "minimum": 0, "maximum": 1000 }
          },
          "required": ["steps"],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": { "const": "builtin" },
            "name": {
              "enum": ["laser_toggle", "spotlight_toggle", "recenter", "mode_air", "mode_trackpad", "mode_present", "timer_reset"]
            }
          },
          "required": ["name"],
          "additionalProperties": false
        }
      ]
    },
    "haptic": { "enum": ["click", "click_strong", "detent", "edge", "success", "warning", "none"] },
    "control": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "properties": {
            "type": { "const": "button" },
            "label": { "type": "string", "minLength": 1, "maxLength": 18 },
            "icon": { "type": "string", "pattern": "^[a-z0-9-]{1,40}$" },
            "action": { "$ref": "#/$defs/actionRef" },
            "haptic": { "$ref": "#/$defs/haptic" },
            "span": { "type": "integer", "minimum": 1, "maximum": 4 },
            "emphasis": { "enum": ["primary", "secondary", "danger"] }
          },
          "required": ["label", "action"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "dial" },
            "label": { "type": "string", "minLength": 1, "maxLength": 18 },
            "cw": { "$ref": "#/$defs/actionRef" },
            "ccw": { "$ref": "#/$defs/actionRef" },
            "detentsPerTurn": { "type": "integer", "minimum": 4, "maximum": 96 },
            "accelerate": { "type": "boolean" }
          },
          "required": ["label", "cw", "ccw"],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": { "const": "swipe" },
            "left": { "$ref": "#/$defs/actionRef" },
            "right": { "$ref": "#/$defs/actionRef" },
            "up": { "$ref": "#/$defs/actionRef" },
            "down": { "$ref": "#/$defs/actionRef" }
          },
          "minProperties": 3,
          "additionalProperties": false
        }
      ]
    },
    "surface": {
      "type": "object",
      "required": ["mode", "controls"],
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["present", "buttons", "dial", "trackpad", "air", "trackball"] },
        "title": { "type": "string", "maxLength": 24 },
        "controls": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/control" } }
      }
    }
  }
}
