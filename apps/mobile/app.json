{
  "expo": {
    "name": "Vanepoint",
    "slug": "vanepoint",
    "scheme": "vanepoint",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.vanepoint.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Vanepoint uses the camera only to scan the pairing code shown on your computer.",
        "NSLocalNetworkUsageDescription": "Vanepoint connects to your computer over your local network.",
        "NSMotionUsageDescription": "Vanepoint uses motion sensors to move the pointer when you point your phone.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.vanepoint.app",
      "adaptiveIcon": {
        "backgroundColor": "#6E56CF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Vanepoint uses the camera only to scan the pairing code shown on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store"
    ]
  }
}
